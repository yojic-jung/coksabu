<?xml version="1.0" encoding="UTF-8"?>

<!-- default directory 설정 -->
<decorators defaultdir="/WEB-INF/view">

	<!-- 메인페이지는 데코레이터 적용 없이 따로 구현됨 -->


	<decorator name="sampleLayout" page="lessonking_decorator.jsp">
		<pattern>/boarder*</pattern>
		<pattern>/applylist*</pattern>
		<pattern>/lessonapply*</pattern>
		<pattern>/companyInfo*</pattern>
		<pattern>/useGuide*</pattern>
		<pattern>/tutorUseGuide*</pattern>
		<pattern>/customer*</pattern>
		<pattern>/qna*</pattern>
		<pattern>/myqna*</pattern>
	</decorator>
	
	<decorator name="applyLayout" page="apply_decorator.jsp">
		<pattern>/boardread*</pattern>
		<pattern>/apply*</pattern>
		<pattern>/applysuccess*</pattern>
	</decorator>
	
	
	<decorator name="mypageLayout" page="mypage_decorator.jsp">
		<pattern>/mypage*</pattern>
		<pattern>/purchaselist*</pattern>
		<pattern>/proposalpurchase*</pattern>
		<pattern>/wishlist*</pattern>
	</decorator>
	
	<decorator name="tutorLayout" page="tutor_decorator.jsp">
		<pattern>/tutorpage*</pattern>
		<pattern>/lessoncertify*</pattern>
		<pattern>/saleslist*</pattern>
		<pattern>/proposalsell*</pattern>
	</decorator>
	
	<decorator name="userLayout" page="user_decorator.jsp">
		<pattern>/teacherForm*</pattern>
	</decorator>

	<decorator name="myroomLayout" page="myroom_decorator.jsp">
		<pattern>/myroom*</pattern>
	</decorator>
	
	<decorator name="category" page="category_decorator.jsp">
		<pattern>/category*</pattern>
	</decorator>
	
	<decorator name="titleLayout" page="title_decorator.jsp">
		<pattern>/signup*</pattern>
		<pattern>/private*</pattern>
		<pattern>/service*</pattern>
		<pattern>/emailPassFind*</pattern>
		<pattern>/privateData*</pattern>
	</decorator>
	
	<decorator name="backLayout" page="back_decorator.jsp">
		<pattern>/usersetting*</pattern>
		<pattern>/passwordsetting*</pattern>
		<pattern>/myaccountinfo*</pattern>
		<pattern>/nicknameUpdate*</pattern>
		<pattern>/secession*</pattern>
		<pattern>/promotion*</pattern>
		
		<pattern>/certify*</pattern>
		<pattern>/lessonWrite*</pattern>
		<pattern>/update*</pattern>
		<pattern>/teacherApply*</pattern>
		
		<pattern>/lessonPurchase*</pattern>
		<pattern>/profile*</pattern>
		<pattern>/tutorprofile*</pattern>
		<pattern>/myproposal*</pattern>
		
		<pattern>/orderInfo*</pattern>
		<pattern>/proposalOrderInfo*</pattern>
		<pattern>/sellerorderInfo*</pattern>
		<pattern>/sellerProposalOrderInfo*</pattern>
		<pattern>/buyerRefundCompleteInfo*</pattern>
		<pattern>/sellerRefundCompleteInfo*</pattern>
		<pattern>/buyerRefundCompletePro*</pattern>
		<pattern>/sellerRefundCompletePro*</pattern>
		<pattern>/refund*</pattern>
		<pattern>/sellerrefundM*</pattern>
		<pattern>/refundproposal*</pattern>
		<pattern>/sellerRefundProM*</pattern>
	</decorator>
	
	<decorator name="chatLayout" page="chat_decorator.jsp">
		<pattern>/chatroom*</pattern>
		<pattern>/chatmyroom*</pattern>
	</decorator>
	
	
	<!-- /message페이지는 웹소켓이 있어 모바일 데스크톱 환경 구분이 느려 데코레이터에는 아무 기능없고
		 message.jsp와 message.mobile.jsp에 데스크톱용 모바일용 디자인과 기능 각각 구현  -->
	<decorator page="message_decorator.jsp" name="messageLayout">
		<pattern>/message*</pattern>
	</decorator>
	
	<decorator name="noneLayout" page="none_decorator.jsp">
		<!-- /login은 스프링 시큐리티의 로그인 처리 url인 /loginprocess가 데코레이터 안 걸려 
			/login만 title_decorator의 내용을 login.jsp와 login.mobile.jsp에 직접 구현 -->
		<pattern>/login*</pattern>
		<pattern>/subCheckForm*</pattern>
	</decorator>
	
	

</decorators>

